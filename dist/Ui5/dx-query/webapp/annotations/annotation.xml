<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="/dinstitute/control/odataAppSvc/dinstitute/$metadata">
        <edmx:Include Namespace="com.dpbird"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">
            <Annotations Target="com.dpbird.DX">
                <Annotation Term="UI.HeaderFacets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedHeaderFacet1"/>
                            <PropertyValue Property="Label" String="基本信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#BaseInfo"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                             <PropertyValue Property="ID" String="GeneratedFacet1"/>
                            <PropertyValue Property="Label" String="项目信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#ProjectInformation"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet2"/>
                            <PropertyValue Property="Label" String="业主信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#OwnerInformation"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet3"/>
                            <PropertyValue Property="Label" String="外网信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#ExternalNetworkInformation"/>
                        </Record>

                    </Collection>
                </Annotation>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>