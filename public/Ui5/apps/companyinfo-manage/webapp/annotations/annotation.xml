<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="/gongsconfig/control/odataAppSvc/orgStructureManage/$metadata">
        <edmx:Include Namespace="com.dpbird"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">
            <Annotations Target="com.dpbird.O3Container/Companies">
                 <Annotation Term="UI.DeleteHidden" Bool="true"/>  
            </Annotations>
            <Annotations Target="com.dpbird.Member">
                <Annotation Term="UI.LineItem" Qualifier="Member">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="partyName"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="gender"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="birthDate"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="nickName"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="phoneMobile"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="primaryEmail"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="externalId"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="isManager"/>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label"  String="设为部门负责人"/>
                            <PropertyValue Property="Action" String="com.dpbird.SetAsDepartmentManager"/>
                            <PropertyValue Property="Inline" Bool="true"/>
                           <Annotation Term="UI.Hidden" Path="isManager"/>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Action" String="com.dpbird.SetAsOrdinaryEmployee"/>
                            <PropertyValue Property="Label"  String="设为普通员工" />
                            <PropertyValue Property="Inline" Bool="true"/>
                            <Annotation Term="UI.Hidden" Path="isNotManager"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.QuickCreateFacets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="quickcreatefieldgroup"/>
                            <PropertyValue Property="Label" String="添加成员"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#quickcreatefieldgroup"/>
                        </Record>
                    </Collection>
                </Annotation>
                 <Annotation Term="UI.FieldGroup" Qualifier="quickcreatefieldgroup">
                    <Record Type="UI.FieldGroupType">
                        <PropertyValue Property="Data">
                            <Collection>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="partyId"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="partyName"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="gender"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="birthDate"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="nickName"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="phoneMobile"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="primaryEmail"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="externalId"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
            <Annotations Target="com.dpbird.Department">
                <Annotation Term="UI.QuickCreateFacets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="quickcreatefieldgroup"/>
                            <PropertyValue Property="Label" String="新建部门"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#quickcreatefieldgroup"/>
                        </Record>
                    </Collection>
                </Annotation>
                 <Annotation Term="UI.FieldGroup" Qualifier="quickcreatefieldgroup">
                    <Record Type="UI.FieldGroupType">
                        <PropertyValue Property="Data">
                            <Collection>
                               <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="partyName"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="partyId"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <Annotation Term="UI.HeaderFacets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedHeaderFacet1"/>
                            <PropertyValue Property="Label" String="基本信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#BaseInfo"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet1"/>
                            <PropertyValue Property="Label" String="部门"/>
                            <PropertyValue Property="Target" AnnotationPath="SubDepartment/@UI.LineItem#Department"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet2"/>
                            <PropertyValue Property="Label" String="成员"/>
                            <PropertyValue Property="Target" AnnotationPath="Member/@UI.LineItem#Member"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>
            <Annotations Target="com.dpbird.Company">
                <Annotation Term="UI.HeaderFacets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedHeaderFacet1"/>
                            <PropertyValue Property="Label" String="基本信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#BaseInfo"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet1"/>
                            <PropertyValue Property="Label" String="部门"/>
                            <PropertyValue Property="Target" AnnotationPath="Department/@UI.LineItem#Department"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>
            <Annotations Target="com.dpbird.SetAsDepartmentManager">
                <Annotation Term="Common.SideEffects">
                    <Record>
                        <PropertyValue Property="TargetEntities">
                            <Collection>
                                <NavigationPropertyPath>member</NavigationPropertyPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
            <Annotations Target="com.dpbird.SetAsOrdinaryEmployee">
                <Annotation Term="Common.SideEffects">
                    <Record>
                        <PropertyValue Property="TargetEntities">
                            <Collection>
                                <NavigationPropertyPath>member</NavigationPropertyPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>