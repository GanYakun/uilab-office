<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="/gongsconfig/control/odataAppSvc/approvalManage/$metadata">
        <edmx:Include Namespace="com.dpbird"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">
            <Annotations Target="com.dpbird.Approved/statusId">
                <Annotation Term="UI.ParameterDefaultValue" String="WEPR_COMPLETE"/> 
                <Annotation Term="UI.Hidden" Bool="true"/>
                <Annotation Term="Common.FieldControl" EnumMember="Common.FieldControlType/Mandatory"/>
            </Annotations>
            <Annotations Target="com.dpbird.ApproveRefuse/statusId">
                <Annotation Term="UI.ParameterDefaultValue" String="WEPR_REFUSE"/> 
                <Annotation Term="UI.Hidden" Bool="true"/>
                <Annotation Term="Common.FieldControl" EnumMember="Common.FieldControlType/Mandatory"/>
            </Annotations>
            <Annotations Target="com.dpbird.Approved">
                <Annotation Term="Common.SideEffects">
                    <Record>
                        <PropertyValue Property="TargetEntities">
                            <Collection>
                                <NavigationPropertyPath>approval</NavigationPropertyPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
            <Annotations Target="com.dpbird.ApproveRefuse">
                <Annotation Term="Common.SideEffects">
                    <Record>
                        <PropertyValue Property="TargetEntities">
                            <Collection>
                                <NavigationPropertyPath>approval</NavigationPropertyPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
            <Annotations Target="com.dpbird.O3Container/Approvals">
                 <Annotation Term="UI.DeleteHidden" Bool="true"/>  
            </Annotations>
            <Annotations Target="com.dpbird.Approval">
                <Annotation Term="UI.Identification">
                    <Collection>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="审批通过" />
                            <PropertyValue Property="Action" String="com.dpbird.Approved" />
                            <Annotation Term="UI.Hidden">
                                <If>
                                    <Eq>
                                        <Path>statusId</Path>
                                        <String>WEPR_WAIT</String>
                                    </Eq>
                                    <Bool>false</Bool>
                                    <Bool>true</Bool>
                                </If>
                            </Annotation>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="审批不通过" />
                            <PropertyValue Property="Action" String="com.dpbird.ApproveRefuse" />
                            <Annotation Term="UI.Hidden">
                                <If>
                                    <Eq>
                                        <Path>statusId</Path>
                                        <String>WEPR_WAIT</String>
                                    </Eq>
                                    <Bool>false</Bool>
                                    <Bool>true</Bool>
                                </If>
                            </Annotation>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.SelectionPresentationVariant" Qualifier="WaitApproval">
                    <Record Type="UI.SelectionPresentationVariantType">
                        <PropertyValue Property="Text" String="待审批" />
                        <PropertyValue Property="SelectionVariant">
                            <Record Type="UI.SelectionVariantType">
                                <PropertyValue Property="SelectOptions">
                                    <Collection>
                                        <Record Type="UI.SelectOptionType">
                                            <PropertyValue Property="PropertyName" PropertyPath="statusId" />
                                            <PropertyValue Property="Ranges">
                                                <Collection>
                                                    <Record Type="UI.SelectionRangeType">
                                                        <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I" />
                                                        <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ" />
                                                        <PropertyValue Property="Low" String="WEPR_WAIT" />
                                                    </Record>
                                                </Collection>
                                            </PropertyValue>
                                        </Record>
                                    </Collection>
                                </PropertyValue>
                            </Record>
                        </PropertyValue>
                        <PropertyValue Property="PresentationVariant">
                            <Record Type="UI.PresentationVariantType">
                                <PropertyValue Property="Visualizations">
                                    <Collection>
                                        <AnnotationPath>@UI.LineItem#ApprovalList</AnnotationPath>
                                    </Collection>
                                </PropertyValue>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <Annotation Term="UI.SelectionPresentationVariant" Qualifier="ProcessApproval">
                    <Record Type="UI.SelectionPresentationVariantType">
                        <PropertyValue Property="Text" String="已审批" />
                        <PropertyValue Property="SelectionVariant">
                            <Record Type="UI.SelectionVariantType">
                                <PropertyValue Property="SelectOptions">
                                    <Collection>
                                        <Record Type="UI.SelectOptionType">
                                            <PropertyValue Property="PropertyName" PropertyPath="statusId" />
                                            <PropertyValue Property="Ranges">
                                                <Collection>
                                                    <Record Type="UI.SelectionRangeType">
                                                        <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I" />
                                                        <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/NE" />
                                                        <PropertyValue Property="Low" String="WEPR_WAIT" />
                                                    </Record>
                                                </Collection>
                                            </PropertyValue>
                                        </Record>
                                    </Collection>
                                </PropertyValue>
                            </Record>
                        </PropertyValue>
                        <PropertyValue Property="PresentationVariant">
                            <Record Type="UI.PresentationVariantType">
                                <PropertyValue Property="Visualizations">
                                    <Collection>
                                        <AnnotationPath>@UI.LineItem#ApprovalList</AnnotationPath>
                                    </Collection>
                                </PropertyValue>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <Annotation Term="UI.DataPoint" Qualifier="ApprovalStatus">
                    <Record Type="UI.DataPointType">
                        <PropertyValue Property="Title" String="审批状态"/>
                        <PropertyValue Property="Value" Path="statusId"/>
                    </Record>
                </Annotation>
                <Annotation Term="UI.HeaderFacets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedHeaderFacet1"/>
                            <PropertyValue Property="Label" String="基本信息"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#BaseInfo"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedHeaderFacet2"/>
                            <PropertyValue Property="Label" String="审批状态"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#ApprovalStatus"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet1"/>
                            <PropertyValue Property="Label" String="流程发起人信息"/>
                            <PropertyValue Property="Target" AnnotationPath="RootNodeWorkEffort/@UI.FieldGroup#ApproverInformation"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <Annotation Term="UI.Hidden">
                                <If>
                                    <Eq>
                                        <Path>dbEntityName</Path>
                                        <String>EmplLeave</String>
                                    </Eq>
                                    <Bool>false</Bool>
                                    <Bool>true</Bool>
                                </If>
                            </Annotation>
                            <PropertyValue Property="ID" String="GeneratedFacet2"/>
                            <PropertyValue Property="Label" String="请假申请信息"/>
                            <PropertyValue Property="Target" AnnotationPath="LeaveApproval/@UI.FieldGroup#BaseInfo"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <Annotation Term="UI.Hidden">
                                <If>
                                    <Eq>
                                        <Path>dbEntityName</Path>
                                        <String>Requirement</String>
                                    </Eq>
                                    <Bool>false</Bool>
                                    <Bool>true</Bool>
                                </If>
                            </Annotation>
                            <PropertyValue Property="ID" String="GeneratedFacet3"/>
                            <PropertyValue Property="Label" String="资产领用申请信息"/>
                            <PropertyValue Property="Target" AnnotationPath="AssetPickUpRequest/@UI.FieldGroup#BaseInfo"/>
                        </Record>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="GeneratedFacet4"/>
                            <PropertyValue Property="Label" String="审批记录"/>
                            <PropertyValue Property="Target" AnnotationPath="ApprovalRecord/@UI.LineItem#RecordApproval"/>                        
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>